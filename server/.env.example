# Copy to .env and fill in real values before deploying anywhere real
# traffic (or real auth-api/MySQL access) is involved. With nothing set,
# the server runs in dev mode: an in-memory mock of the shared platform
# tables, a locally-generated JWT secret, and no calls to any real service.

# ── Server ───────────────────────────────────────────────────────
PORT=4000
# Set to "production" to switch on the real auth-api path and require real
# MySQL credentials below. Anything else (including unset) runs dev mode.
NODE_ENV=development

# ── auth-api (SSO_TENANCY.md) ───────────────────────────────────
# Base URL of the real auth-api service. Only reached when NODE_ENV=production.
AUTH_API_URL=http://127.0.0.1:8080
# Fixed tenant slug for this deployment (SSO_TENANCY.md §4 Pattern A).
AUTH_API_TENANT_SLUG=kumbh

# ── Shared JWT secret ────────────────────────────────────────────
# MUST be the byte-for-byte identical value from /opt/auth-api/.env's
# JWT_SECRET on the production box. Verify with a SHA256 hash comparison,
# never by printing the raw value. Leave unset for dev mode only - a random
# value is generated per boot, which is fine for local testing and useless
# for anything else.
JWT_SECRET=

# ── This app's identity with auth-api ───────────────────────────
# The oauth_client_id this app was registered under in auth-api's
# `application` table (SSO_TENANCY.md §5 step 3). Not yet registered as of
# this writing - the value below is a placeholder until that happens.
CLINIC_OAUTH_CLIENT_ID=arogya-kumbh-clinic

# ── MySQL (notes_app on the shared RDS instance) ────────────────
# Leave all four unset for dev mode (in-memory store instead). Setting all
# four switches the server to the real MySQL-backed store.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── OTP ──────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
